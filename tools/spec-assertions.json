{
  "spec": "obsidian-1.13.7",
  "vault": "D:\\DSH记忆\\research\\fixtures\\vault-re",
  "note": "每条用例都可由 P1 索引器直接跑；expected 取自运行时实测或 app.js 静态证据（见 spec §2/§3/§5）。",
  "cases": [
    { "id": "res-01", "kind": "link-resolve", "source": "Links.md", "link": "Index", "expected": "a/Index.md", "why": "同名 → 同目录(根)优先 + 短路径优先" },
    { "id": "res-02", "kind": "link-resolve", "source": "a/x.md", "link": "Index", "expected": "a/Index.md", "why": "同目录优先" },
    { "id": "res-03", "kind": "link-resolve", "source": "b/x.md", "link": "Index", "expected": "b/Index.md", "why": "同目录优先" },
    { "id": "res-04", "kind": "link-resolve", "source": "Links.md", "link": "a/Index", "expected": "a/Index.md", "why": "全路径精确命中" },
    { "id": "res-05", "kind": "link-resolve", "source": "Links.md", "link": "note", "expected": "Note.md", "why": "大小写不敏感" },
    { "id": "res-06", "kind": "link-resolve", "source": "Links.md", "link": "NOTE", "expected": "Note.md", "why": "大小写不敏感" },
    { "id": "res-07", "kind": "link-resolve", "source": "Links.md", "link": "Note.md", "expected": "Note.md", "why": "带扩展名亦命中" },
    { "id": "res-08", "kind": "link-resolve", "source": "Links.md", "link": "中文 笔记", "expected": "中文 笔记.md", "why": "CJK + 空格" },
    { "id": "res-09", "kind": "link-resolve", "source": "Links.md", "link": "Does Not Exist", "expected": null, "why": "未解析 → unresolvedLinks" },
    { "id": "res-10", "kind": "link-resolve", "source": "Links.md", "link": "attachments/pixel.png", "expected": "attachments/pixel.png", "why": "非 md 附件同样解析" },
    { "id": "res-11", "kind": "link-resolve", "source": "Links.md", "link": "Note#^does-not-exist", "expected": "Note.md", "why": "subpath 无效不影响路径解析；不计入 unresolved" },

    { "id": "blk-01", "kind": "block-id", "file": "Blocks.md", "id": "para-1", "expected": { "nodeType": "paragraph", "startLine": 2, "endLine": 2 }, "why": "段落尾 ID" },
    { "id": "blk-02", "kind": "block-id", "file": "Blocks.md", "id": "lone-paragraph-id", "expected": { "nodeType": "paragraph" }, "why": "整行只有 ^id 也成立" },
    { "id": "blk-03", "kind": "block-id", "file": "Blocks.md", "id": "quote-1", "expected": { "nodeType": "blockquote", "startLine": 14, "endLine": 15 }, "why": "ID 归属整个引用块" },
    { "id": "blk-04", "kind": "block-id", "file": "Blocks.md", "id": "table-1", "expected": { "nodeType": "table", "startLine": 17, "endLine": 19 }, "why": "表格下 ID 归表格" },
    { "id": "blk-05", "kind": "block-id", "file": "Blocks.md", "id": "li-1", "expected": { "nodeType": "listItem", "startLine": 8 }, "why": "列表项 ID" },
    { "id": "blk-06", "kind": "block-id", "file": "Blocks.md", "id": "li-2", "expected": { "nodeType": "listItem", "startLine": 10 }, "why": "嵌套列表项 ID" },
    { "id": "blk-07", "kind": "block-id", "file": "Blocks.md", "id": "ol-1", "expected": { "nodeType": "listItem", "startLine": 12 }, "why": "有序列表项 ID" },
    { "id": "blk-08", "kind": "block-id", "file": "Blocks.md", "id": "head-1", "expected": { "nodeType": "heading", "startLine": 46 }, "why": "标题行 ID" },
    { "id": "blk-09", "kind": "block-id", "file": "Blocks.md", "id": "upper-1", "expected": { "originalId": "UPPER-1" }, "why": "缓存键小写、id 保留原大小写" },
    { "id": "blk-10", "kind": "block-id", "file": "Blocks.md", "id": "mid-1", "expected": null, "why": "ID 不在行尾 → 不成立" },
    { "id": "blk-11", "kind": "block-id", "file": "Blocks.md", "id": "dot-1", "expected": null, "why": "行尾多一个 . → 不成立" },
    { "id": "blk-12", "kind": "block-id", "file": "Blocks.md", "id": "nosep-1", "expected": null, "why": "^ 前无空白 → 不成立" },
    { "id": "blk-13", "kind": "block-id", "file": "Blocks.md", "id": "bad", "expected": null, "why": "ID 含空格 → 不成立" },
    { "id": "blk-14", "kind": "block-id", "file": "Blocks.md", "id": "中文id", "expected": null, "why": "非 ASCII → 不成立" },
    { "id": "blk-15", "kind": "block-id", "file": "Blocks.md", "id": "in-code", "expected": null, "why": "围栏代码内 → 不成立" },
    { "id": "blk-16", "kind": "block-id", "file": "Blocks.md", "id": "in-indent-code", "expected": null, "why": "缩进代码内 → 不成立" },
    { "id": "blk-17", "kind": "block-id", "file": "Blocks.md", "id": "inline-code", "expected": null, "why": "行内代码内 → 不成立" },
    { "id": "blk-18", "kind": "block-id", "file": "CRLF.md", "id": "crlf-1", "expected": { "exists": true }, "why": "CRLF 文件同样成立；offset 含 \\r\\n 两字节" },

    { "id": "sub-01", "kind": "subpath", "file": "Note.md", "subpath": "#^para-1", "expected": { "resolved": false }, "why": "跨文件引用必须带文件名；Note.md 无此块" },
    { "id": "sub-02", "kind": "subpath", "file": "Blocks.md", "subpath": "#^para-1", "expected": { "type": "block", "startOffset": 10, "endOffset": 48 }, "why": "块区间 = 节点区间" },
    { "id": "sub-03", "kind": "subpath", "file": "Note.md", "subpath": "#Heading Two", "expected": { "type": "heading", "startLine": 10, "endLine": 13 }, "why": "标题区间 = 从标题行起，到下一个同级/更高级标题。原记录 12/14 与仓内 fixture 对不上（该文件标题在 0-based 第 10 行）；起点=标题行已由用户在 Obsidian 实测确认，数字按当前 fixture 重算" },
    { "id": "sub-04", "kind": "subpath", "file": "Headings.md", "subpath": "#With pipe", "expected": { "resolved": true }, "why": "TD 归一化把 | 变空格" },
    { "id": "sub-05", "kind": "subpath", "file": "Headings.md", "subpath": "#With caret", "expected": { "resolved": true }, "why": "^ 在 TD 的剔除集合里" },
    { "id": "sub-06", "kind": "subpath", "file": "Headings.md", "subpath": "#Simple", "expected": { "resolved": true, "note": "首个匹配优先" }, "why": "重复标题取第一个" },

    { "id": "lnk-01", "kind": "link-cache", "file": "Links.md", "original": "[[Note#^para-1]]", "expected": { "link": "Note#^para-1", "displayText": "Note > ^para-1" }, "why": "link 保留原始 linktext；displayText 用 ' > '" },
    { "id": "lnk-02", "kind": "link-cache", "file": "Links.md", "original": "[[Note#Heading Two|别名二]]", "expected": { "link": "Note#Heading Two", "displayText": "别名二" }, "why": "别名优先于默认 displayText" },
    { "id": "lnk-03", "kind": "code-protection", "file": "Links.md", "text": "[[Note]] inside inline code or fence", "expected": { "counted": false }, "why": "代码内不产出 link" },
    { "id": "lnk-04", "kind": "nested-reject", "file": "fixture", "text": "[[a[[b]]]]", "expected": { "parsed": false }, "why": "内层含 [[ 直接拒" },

    { "id": "fm-01", "kind": "frontmatter", "file": "Frontmatter.md", "key": "number_prop", "expected": 42 },
    { "id": "fm-02", "kind": "frontmatter", "file": "Frontmatter.md", "key": "bool_prop", "expected": true },
    { "id": "fm-03", "kind": "frontmatter", "file": "Frontmatter.md", "key": "date_prop", "expected": "2026-10-22", "why": "不做日期强转" },
    { "id": "fm-04", "kind": "frontmatter", "file": "Frontmatter.md", "key": "empty_prop", "expected": null },
    { "id": "fm-05", "kind": "frontmatter", "file": "Frontmatter.md", "key": "aliases", "expected": "single-alias", "why": "不强制数组" },
    { "id": "fm-06", "kind": "frontmatter", "file": "Frontmatter.md", "key": "tags", "expected": "nested/tag/deep", "why": "frontmatter tags 不进 cache.tags" },
    { "id": "fm-07", "kind": "cache-keys", "file": "Note.md", "expected": ["headings", "sections", "frontmatter", "frontmatterPosition", "frontmatterLinks"], "why": "空集会被 delete" }
  ]
}
